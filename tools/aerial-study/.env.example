# Aerial Study Guard — copy to .env and edit. Docker Compose reads this file.
# NEVER commit .env (it is in .gitignore/.dockerignore).

# --- paths inside the container (host path is mounted at /data) -----------
DATA_DIR=/data
IMAGES_DIR=/data/images
MATERIALS_DIR=/data/materials
DB_PATH=/data/study.db

# --- access control -------------------------------------------------------
# Shared token the TV app must send (Authorization: Bearer ... or X-Study-Token).
# Generate with: openssl rand -hex 32
STUDY_DEVICE_TOKEN=change-me-study-device-token

# Admin page password. Leave empty to disable /admin entirely.
ADMIN_PASSWORD=change-me-admin-password

# Optional extra HMAC secret for admin cookies. If empty, derived from ADMIN_PASSWORD.
ADMIN_SECRET_KEY=
ADMIN_SESSION_HOURS=12

# --- quiz -----------------------------------------------------------------
SESSION_TTL_HOURS=24
QUESTIONS_PER_SESSION=5
IMAGE_MAX_MB=10

# --- speech to text (CPU only) -------------------------------------------
# tiny | base | small | medium | large-v3 ... base/small are sensible on a NAS.
# Headerless 16-bit PCM sent by the TV is wrapped in a WAV container.

# --- AI providers (optional; leave keys empty to use manual drafts only) ---
# Keys are read only from this environment and are never stored or returned.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_AUTH_HEADER=Authorization

XIAOMI_MIMO_API_KEY=
# Set to your MiMo OpenAI-compatible endpoint, e.g. https://.../v1
XIAOMI_MIMO_BASE_URL=
XIAOMI_MIMO_MODEL=
XIAOMI_MIMO_AUTH_HEADER=Authorization

AI_PROVIDER=deepseek
# Optional fallback AI text judge when exact answer matching fails.
AI_JUDGE_ENABLED=0
AI_TIMEOUT_SECONDS=60

# --- runtime --------------------------------------------------------------
# Optional absolute prefix for imageUrl values returned to the TV.
# Leave empty for relative URLs (e.g. /api/v1/images/<sha>?s=<session>).
PUBLIC_BASE_URL=
PORT=8900
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# Comma/colon-separated allow-listed directories for admin material scanning.
STUDY_SCAN_ROOTS=/data/inbox
